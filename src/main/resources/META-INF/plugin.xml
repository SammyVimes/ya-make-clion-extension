<idea-plugin>
    <id>com.github.sammyvimes.yamakeplugin</id>
    <name>Ya Make</name>
    <vendor url="https://senyarobot.duckdns.org">SenyaRobot</vendor>

    <description><![CDATA[
      Native Ya Make project, code generation, build, test, and debug integration for CLion.
    ]]></description>

    <depends>com.intellij.modules.clion</depends>
    <depends>com.intellij.nativeDebug</depends>
    <depends>com.intellij.clion-compdb</depends>
    <depends>org.jetbrains.plugins.clion.radler</depends>

    <extensions defaultExtensionNs="com.intellij">
        <projectConfigurable
            parentId="build"
            id="YaMake.Settings"
            displayName="Ya Make"
            nonDefaultProject="true"
            instance="com.github.sammyvimes.yamakeplugin.YaPluginSettingsConfigurable"/>
        <runConfigurationProducer
            implementation="com.github.sammyvimes.yamakeplugin.YaUnitTestRunConfigurationProducer"/>
        <runLineMarkerContributor
            language="C++"
            implementationClass="com.github.sammyvimes.yamakeplugin.YaUnitTestRunLineMarkerContributor"/>
        <editorNotificationProvider
            implementation="com.github.sammyvimes.yamakeplugin.YaMakeEditorNotification"/>
        <stepsBeforeRunProvider
            implementation="com.github.sammyvimes.yamakeplugin.YaPrepareTestBeforeRunTaskProvider"/>
        <treeStructureProvider
            implementation="com.github.sammyvimes.yamakeplugin.YaCodeGenHider"/>
        <notificationGroup id="Ya Make" displayType="BALLOON"/>
        <editorFactoryListener
            implementation="com.github.sammyvimes.yamakeplugin.YaRunMarkerDeduplicator"/>
        <!-- TEMP: diagnostics for the duplicate-gutter investigation; remove afterwards. -->
        <editorFactoryListener
            implementation="com.github.sammyvimes.yamakeplugin.YaGutterDebugEditorFactoryListener"/>
    </extensions>

    <extensions defaultExtensionNs="cidr.debugger">
        <debugProcessConfigurator
            implementation="com.github.sammyvimes.yamakeplugin.YaDebugProcessConfigurator"/>
    </extensions>

    <actions>
        <action
            id="YaMake.RefreshProject"
            class="com.github.sammyvimes.yamakeplugin.YaRefreshProjectAction"
            text="Refresh Ya C++ Project"
            description="Run Ya code generation and refresh compile_commands.json"
            icon="AllIcons.Actions.Refresh">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <!-- TEMP: diagnostics for the duplicate-gutter investigation; remove afterwards. -->
        <action
            id="YaMake.DumpLineMarkers"
            class="com.github.sammyvimes.yamakeplugin.YaDumpLineMarkersAction"
            text="Ya Make: Dump Line Markers (Debug)"
            description="Dump backend line markers of the focused editor to idea.log and clipboard">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>

    <idea-version since-build="261" until-build="261.*"/>
</idea-plugin>
